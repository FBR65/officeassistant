[Unit]
Description=Keycloak (OIDC-Aussteller vor LDAP/Active Directory)
After=network-online.target

[Container]
ContainerName=oa-keycloak
Image=docker.io/keycloak/keycloak:26.0
Network=oa.network
PublishPort=127.0.0.1:8180:8080
Volume=oa-keycloak:/opt/keycloak/data:Z
Environment=KC_BOOTSTRAP_ADMIN_USERNAME=admin
Secret=keycloak-admin-password,type=env,target=KC_BOOTSTRAP_ADMIN_PASSWORD
Exec=start-dev --import-realm
HealthCmd=bash -c "exec 3<>/dev/tcp/127.0.0.1/8080 && echo ok"
HealthInterval=30s
HealthStartPeriod=60s

[Service]
Restart=always

[Install]
WantedBy=default.target
