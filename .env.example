# Beispielkonfiguration. Kopie nach `.env` und Werte einsetzen.
# Kein Wert aus dieser Datei gehört ins Repository.

# Modellzugriff über llama-swap (OpenAI-kompatibel)
OA_MODEL_BASE_URL=http://127.0.0.1:8080/v1
OA_MODEL_API_KEY=none
OA_ROLE_LEADER=deepseek-v4-pro-qwen3.5-9b
OA_ROLE_DRAFTING=deepseek-v4-pro-qwen3.5-9b
OA_ROLE_TRIAGE=deepseek-v4-pro-qwen3.5-9b

# Datenbank
OA_DB_URL=postgresql://oa:oa@127.0.0.1:55432/oa

# Schlüssel für die Postfach-Token (Fernet, 44 Zeichen)
# Erzeugen: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OA_TOKEN_KEY=

# Identität: Keycloak vor LDAP (später Active Directory)
OA_OIDC_ISSUER=http://127.0.0.1:8180/realms/oa
OA_OIDC_CLIENT_ID=oa-ui
OA_OIDC_CLIENT_SECRET=
OA_OIDC_REDIRECT_URL=http://127.0.0.1:8099/auth/callback

# Oberfläche und API
OA_UI_HOST=127.0.0.1
OA_UI_PORT=8099
OA_API_BASE_URL=http://127.0.0.1:7777
OA_KOLIBRI_DIR=assets/kolibri
OA_AGENT_ID=office-assistant

# Dienstkonto, das Freigaben auflöst (Variante B). Agno lässt bei eingeschalteter
# Nutzertrennung nur administrative Kennungen auflösen, deshalb trägt dieses Token
# `agent_os:admin`. Es gehört ausschließlich in den Prozess der Oberfläche.
# Erzeugen: AGNO_ADMIN_TOKEN=<admin-jwt> uv run agno tokens create approver-admin \
#           --scopes agent_os:admin --privileged --url http://127.0.0.1:7777
OA_APPROVER_TOKEN=
