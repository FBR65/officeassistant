{
  "realm": "oa",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 600,
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "ldap-oa",
        "providerId": "ldap",
        "subType": "ldap",
        "config": {
          "enabled": [
            "true"
          ],
          "priority": [
            "0"
          ],
          "vendor": [
            "other"
          ],
          "connectionUrl": [
            "ldap://oa-ldap:1389"
          ],
          "usersDn": [
            "ou=users,dc=example,dc=org"
          ],
          "bindDn": [
            "cn=admin,dc=example,dc=org"
          ],
          "bindCredential": [
            "adminpw"
          ],
          "authType": [
            "simple"
          ],
          "usernameLDAPAttribute": [
            "uid"
          ],
          "rdnLDAPAttribute": [
            "cn"
          ],
          "uuidLDAPAttribute": [
            "uid"
          ],
          "userObjectClasses": [
            "inetOrgPerson"
          ],
          "editMode": [
            "READ_ONLY"
          ],
          "importEnabled": [
            "true"
          ],
          "syncRegistrations": [
            "false"
          ],
          "searchScope": [
            "1"
          ],
          "validatePasswordPolicy": [
            "false"
          ],
          "trustEmail": [
            "true"
          ],
          "allowKerberosAuthentication": [
            "false"
          ],
          "useKerberosForPasswordAuthentication": [
            "false"
          ],
          "changedSyncPeriod": [
            "-1"
          ],
          "fullSyncPeriod": [
            "-1"
          ],
          "batchSizeForSync": [
            "1000"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "oa-ui",
      "name": "OfficeAssistant UI",
      "enabled": true,
      "publicClient": false,
      "secret": "oasecret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:8099/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "agno-scopes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "scopes",
            "claim.value": "[\"agent_os:admin\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}